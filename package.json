{
    "name": "kerplunk",
    "version": "0.1.0",
    "description": "Compile Markdown course material into Canvas-safe, accessible HTML with inlined theme styles and Canvas QTI quizzes.",
    "main": "index.js",
    "bin": {
        "kerplunk": "./bin/kerplunk.js"
    },
    "files": [
        "bin",
        "src",
        "themes",
        "index.js"
    ],
    "scripts": {
        "test": "node --test",
        "test:watch": "node --test --watch",
        "bundle": "node scripts/bundle.js",
        "install-cli": "node scripts/install-cli.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">=18"
    },
    "author": "Eric Artzt",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "adm-zip": "^0.6.1",
        "juice": "^11.0.3",
        "postcss": "^8.5.6",
        "postcss-css-variables": "^0.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10"
    }
}
